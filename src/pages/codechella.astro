---
import Layout from "../layouts/Layout.astro"
---

<Layout title="CodeChella - Mixtape Sessions">
	<div class="pb-48 pt-24">
		<!-- Hero -->
		<div class="max-w-lg pb-24 mx-auto px-4 md:px-12 xl:px-0 text-center">
			<p class="text-picton-blue-400 font-marker text-xl">Introducing</p>
			<h1 class="font-marker text-6xl md:text-8xl tracking-tight mb-12">
				CodeChella
			</h1>
			<p
				class="text-xl md:text-2xl mt-12 text-slate-500 mx-auto leading-relaxed"
			>
				Multi-day, in-person workshops on applied causal inference methods.
				Learn difference-in-differences, synthetic control, and panel data
				econometrics from the people who write the papers.
			</p>
		</div>

		<!-- What is it -->
		<div
			class="w-full max-w-lg mt-24 mx-auto px-4 md:px-12 xl:px-0 prose lg:prose-lg"
		>
			<h2 class="text-3xl lg:text-4xl font-marker text-slate-900 mb-6">
				What is CodeChella?
			</h2>
			<p class="text-lg text-slate-600 leading-relaxed">
				CodeChella is a traveling workshop series hosted by Mixtape Sessions in
				partnership with universities around the world. Each event is a
				concentrated, hands-on deep dive into modern causal inference methods
				&mdash; focused on practical implementation rather than just theory.
			</p>

			<p>
				CodeChella is taught by <strong class="text-slate-900"
					>Scott Cunningham</strong
				> (Baylor University),
				<strong class="text-slate-900">Kyle Butts</strong> (University of Arkansas),
				<strong class="text-slate-900">Mark Anderson</strong> (Montana State), and
				<strong class="text-slate-900">Daniel Rees</strong> (UC3M).
			</p>
		</div>

		<!-- What to Expect -->
		<div
			class="w-full max-w-lg mt-24 mx-auto px-4 md:px-12 xl:px-0 prose lg:prose-lg"
		>
			<h2 class="text-3xl lg:text-4xl font-marker text-slate-900 mb-6">
				What to Expect
			</h2>

			<ul>
				<li>
					<p class="text-lg text-slate-600">
						<strong class="text-slate-900">3&ndash;4 days</strong> of intensive, in-person
						instruction
					</p>
				</li>
				<li>
					<p class="text-lg text-slate-600">
						<strong class="text-slate-900">The full DID pipeline</strong> &mdash;
						from basics through staggered timing, doubly robust estimators, and modern
						alternatives
					</p>
				</li>
				<li>
					<p class="text-lg text-slate-600">
						<strong class="text-slate-900"
							>Synthetic control &amp; factor models</strong
						> &mdash; from introductory to advanced
					</p>
				</li>
				<li>
					<p class="text-lg text-slate-600">
						<strong class="text-slate-900">Hands-on coding</strong> &mdash; every
						topic comes with live coding exercises and worked examples
					</p>
				</li>
				<li>
					<p class="text-lg text-slate-600">
						<strong class="text-slate-900">Small-group format</strong> &mdash; ask
						questions, get feedback, and interact directly with the instructors
					</p>
				</li>
				<li>
					<p class="text-lg text-slate-600">
						<strong class="text-slate-900">Open-sourced materials</strong> &mdash;
						everything is shared on our <a
							href="https://github.com/Mixtape-Sessions"
							class="underline text-electric-violet-700 hover:text-electric-violet-900"
							>GitHub</a
						> after the workshop
					</p>
				</li>
			</ul>
		</div>

		<!-- Events -->
		<div
			class="w-full max-w-lg mt-24 mx-auto px-4 md:px-12 xl:px-0 prose lg:prose-lg"
		>
			<h2 class="text-3xl lg:text-4xl font-marker text-slate-900 mb-6">
				Past &amp; Upcoming CodeChella Events
			</h2>
		</div>
		<div
			class="w-full max-w-lg mt-12 mx-auto px-4 md:px-12 xl:px-0 grid grid-cols-1 gap-y-8"
		>
			<div
				class="group border border-electric-violet-400 hover:border-electric-violet-800 rounded-xl px-8 py-8 hover:shadow-lg transition-all"
			>
				<p class="text-sm text-slate-400 mb-2">January 11&ndash;14, 2027</p>
				<h3
					class="font-marker text-3xl text-slate-900 group-hover:text-electric-violet-600 transition-colors mb-2"
				>
					CodeChella Mexico City
				</h3>
				<p class="text-slate-500 text-lg">
					Instituto Tecnol&oacute;gico Aut&oacute;nomo de M&eacute;xico (ITAM)
				</p>
				<a href="/mexico_city">
					<p
						class="inline-block mt-8 text-electric-violet-600 font-semibold text-sm group-hover:underline"
					>
						Learn more &rarr;
					</p>
				</a>
			</div>

			<div
				class="group border border-dashed border-slate-200 hover:border-electric-violet-800 rounded-xl px-8 py-8 hover:shadow-lg transition-all"
			>
				<p class="text-sm text-slate-400 mb-2">
					May 25&ndash;28, 2026 &mdash; 3rd Edition
				</p>
				<h3
					class="font-marker text-3xl text-slate-900 group-hover:text-electric-violet-600 transition-colors mb-2"
				>
					CodeChella Madrid
				</h3>
				<p class="text-slate-500 text-lg">CUNEF Universidad</p>
				<a href="/madrid">
					<p
						class="inline-block mt-8 text-electric-violet-600 font-semibold text-sm group-hover:underline"
					>
						Learn more &rarr;
					</p>
				</a>
			</div>
		</div>
	</div>
</Layout>
